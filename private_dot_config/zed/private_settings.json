// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "tab_size": 2,
  "buffer_font_family": "JetBrains Mono",

  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "title_bar": {
    "show_sign_in": false,
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "disable_ai": true,

  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },

  "languages": {
    "R": {
      "language_servers": ["air"],
    },
    "LaTeX": {
      "soft_wrap": "editor_width",
      "formatter": {
        "external": {
          "command": "tex-fmt",
          "arguments": ["--nowrap", "--stdin"],
        },
      },
    },
    "BibTeX": {
      "formatter": {
        "external": {
          "command": "tex-fmt",
          "arguments": ["--nowrap", "--stdin"],
        },
      },
    },
  },
}
